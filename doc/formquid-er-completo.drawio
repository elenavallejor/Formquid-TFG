        <mxCell id="fk32" value="FK3 · DELETE RESTRICT" edge="1" parent="1" source="categories.code" target="blocks.category" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;startSize=14;endArrow=ERzeroToMany;endFill=0;endSize=14;strokeColor=#475569;fontSize=10;labelBackgroundColor=#ffffff;jettySize=auto;">
